; Усі рахунки обліку; операції генерує import.py з CSV і rules.csv.
option "title" "Оля"
option "operating_currency" "PLN"

2026-07-31 open Assets:Банк PLN
2026-07-31 open Equity:Початковий-Залишок PLN
2026-07-31 open Income:Зарплата PLN
2026-07-31 open Income:Інше PLN
2026-07-31 open Expenses:Житло PLN
2026-07-31 open Expenses:Продукти PLN
2026-07-31 open Expenses:Кафе PLN
2026-07-31 open Expenses:Доставка-Їжі PLN
2026-07-31 open Expenses:Транспорт PLN
2026-07-31 open Expenses:Підписки PLN
2026-07-31 open Expenses:Звязок PLN
2026-07-31 open Expenses:Косметика-і-Побут PLN
2026-07-31 open Expenses:Спорт PLN
2026-07-31 open Expenses:Без-Категорії PLN

2026-07-31 * "Початковий залишок"
  Assets:Банк                     4500.00 PLN
  Equity:Початковий-Залишок      -4500.00 PLN

include "transactions.beancount"

2026-10-16 query "1 Витрати за категоріями" "
SELECT year, month, account, sum(number) AS expenses_pln
WHERE account ~ '^Expenses:'
GROUP BY year, month, account
ORDER BY year, month, account
"

; Календарні запити за окремим проханням Олі; жовтень неповний.
2026-10-16 query "2 Норма заощаджень" "
SELECT year, month,
  -sum(number * int(account ~ '^Income:')) AS income_pln,
  sum(number * int(account ~ '^Expenses:')) AS expenses_pln,
  -sum(number) AS saved_pln,
  round(100 * sum(number) / sum(number * int(account ~ '^Income:')), 2) AS savings_percent,
  max(date) AS last_operation
WHERE account ~ '^(Income|Expenses):'
GROUP BY year, month
ORDER BY year, month
"

2026-10-16 query "3 Фіксовані і змінні" "
SELECT year, month,
  sum(number * int('fixed' IN tags)) AS fixed_pln,
  sum(number * int(NOT ('fixed' IN tags))) AS variable_pln,
  sum(number) AS total_pln
WHERE account ~ '^Expenses:'
GROUP BY year, month
ORDER BY year, month
"

2026-10-16 query "4 Без категорії" "
SELECT year, month, date, narration, number AS expenses_pln
WHERE account = 'Expenses:Без-Категорії'
ORDER BY year, month, date
"
